# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Cargo / Tauri
/target/
src-tauri/target/
# Alternate cargo target dirs agents create (target-main, target-refactor, ...)
src-tauri/target-*/
src-tauri/gen/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Tauri updater 签名私钥（绝不入库；公钥内嵌于 tauri.conf.json）
*.key
!*.key.pub

# TypeScript build info and local agent clutter
*.tsbuildinfo
vite.config.js
vite.config.d.ts
.playwright-mcp/

# Local installers. Updater metadata stays in release/latest.json.
release/*.exe
release/*.exe.sig
release/*.sig
release/*.nsis.zip
release/*.zip

# daemon sidecar（scripts/build-daemon.mjs 生成）
src-tauri/binaries/
